# JWT Secret for authenticating with the backend
# Change this to a secure random string in production
GOVI_JWT_SECRET="default-dev-secret-key-change-in-prod"

# Set to "1" or "true" to disable JWT validation during testing
# DO NOT USE THIS IN PRODUCTION
DISABLE_JWT_VALIDATION="0"

# Grok Vision API Fallback Configuration
GROK_API_KEY=""
GROK_FALLBACK_THRESHOLD="0.60"
GROK_VISION_MODEL="grok-2-vision-1212"
